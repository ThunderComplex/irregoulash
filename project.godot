; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="topdown-shooter"
config/version="0.1.0"
run/main_scene="res://src/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://src/autoload/tuning.gd"
GameInput="*res://src/autoload/game_input.gd"
AudioDirector="*res://src/autoload/audio_director.gd"
MusicDirector="*res://src/autoload/music_director.gd"
Settings="*res://src/autoload/settings.gd"
FxDirector="*res://src/autoload/fx_director.gd"
GameDirector="*res://src/autoload/game_director.gd"
Progress="*res://src/autoload/progress.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/level_tools/plugin.cfg")

[layer_names]

2d_render/layer_1="world"
2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_shot"
2d_physics/layer_5="enemy_shot"
2d_physics/layer_6="pickup"
2d_physics/layer_7="door"
2d_physics/layer_8="sight_only"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.02, 0.024, 0.032, 1)
